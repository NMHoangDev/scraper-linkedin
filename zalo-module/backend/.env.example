# Secret backend thật cho zalo-module. Copy thành `.env` (cùng cấp
# Dockerfile) rồi điền giá trị thật — file này KHÔNG commit (.env đã có
# trong .gitignore).

# ── Supabase / Postgres self-host — CÙNG server với app seeding (tiện, dùng
# lại credential đã có), nhưng zalo-module chỉ đọc/ghi bảng RIÊNG
# (zalo_module_*, xem migrations/001_zalo_module_schema.sql) — không đụng
# bảng zalo_* gốc. Lấy giá trị thật từ docs/INFRASTRUCTURE.md (repo chính).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket RIÊNG cho module này — phải tạo mới trên Supabase Storage (khác
# "zalo-assets" app gốc đang dùng), tránh trộn lẫn file media.
SUPABASE_STORAGE_BUCKET=zalo-module-assets
ZALO_SUPABASE_SSL_VERIFY=true

# ── Đăng nhập web (app_users) — DÙNG CHUNG với app seeding để SSO nhẹ: tài
# khoản đã có ở app seeding đăng nhập được luôn ở module này. Lấy đúng giá
# trị JWT_SECRET_KEY app seeding đang dùng nếu muốn SSO; để giá trị khác nếu
# muốn 2 hệ thống phiên đăng nhập độc lập hoàn toàn.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
LEADER_CODE=8888

# Để RỖNG sẽ TẮT HẲN check X-API-Key giữa frontend/extension và backend —
# chỉ nên rỗng khi chạy local dev, đặt giá trị thật khi deploy ra ngoài.
API_KEY=

# Domain(s) frontend được phép gọi backend (CORS) — thêm domain thật khi
# deploy, mặc định đã có localhost:3000/18190 cho chạy local.
CORS_ORIGINS=http://localhost:3000,http://localhost:18190

# ── Cấu hình riêng module Zalo ────────────────────────────────────────────
ZALO_ZCA_AUTH_STORE_DIR=artifacts/zca-auth
ZALO_DEBUG_ARTIFACTS_DIR=artifacts/debug
ZALO_ASSET_RETENTION_DAYS=7
ZALO_ASSET_CLEANUP_BATCH_SIZE=200
ZALO_ZCA_OLD_MESSAGE_INTERVAL_MS=60000
# Để 0 — luồng backfill lịch sử cũ dùng endpoint Zalo đã ngừng phục vụ, bật
# lên chỉ tốn tài nguyên vô ích (xem docs/ZALO_CHAT_FEATURE_EXTRACTION_GUIDE.md).
ZALO_ZCA_STARTUP_SYNC_ENABLED=0

# Đặt 1 trên môi trường KHÔNG muốn tự động kết nối lại các tài khoản Zalo đã
# đăng nhập khi backend boot (vd 1 bản backend chạy dư/backup).
DISABLE_ZCA_LISTENERS=0
