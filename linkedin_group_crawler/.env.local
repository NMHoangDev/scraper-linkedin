# ============================================================
# LOCAL DEV OVERRIDE — CrawlDataLinkedin
#
# Dùng để test extension trên localhost:3000 (frontend)
# kết nối tới backend local:8000 (api proxy)
#
# Extension gọi Markee service TẠI MÁY LOCAL
# qua backend proxy -> Markee service (https://auto-fb.zenithglobal.dev)
#
# CÁCH DÙNG:
#   1. Chạy backend: py -3 -m uvicorn ... (đọc .env.local)
#   2. Load extension từ thư mục __tmp_markee_extension_local
#   3. Mở localhost:3000, login với user đã có
#   4. Extension sẽ kết nối -> backend local:8000 -> Markee prod
#
# ROLLBACK (khôi phục production):
#   Xóa file này, chỉ dùng file .env gốc
# ============================================================

# Kết nối tới Markee service PRODUCTION
# Backend local đóng vai trò proxy: localhost:8000 -> auto-fb.zenithglobal.dev
MARKEE_FB_BASE_URL=https://auto-fb.zenithglobal.dev

# API Key để backend proxy gọi Markee (key từ VM seeding)
MARKEE_FB_API_KEY=0ZuQJygUBevRMOfMswmNttMGIzet8Y-w

# Key dành cho extension (đọc qua /config endpoint)
MARKEE_FB_EXTENSION_API_KEY=0ZuQJygUBevRMOfMswmNttMGIzet8Y-w

# PORT backend local
PORT=8000
HOST=0.0.0.0

# CORS cho phép frontend local
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3002,http://localhost:3002,http://127.0.0.1:8000,http://localhost:8000

SUPABASE_URL=https://seeding.db.markeeai.com
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgzNTMxNjUyLCJleHAiOjIwOTg4OTE2NTJ9.rfvKDHihgyYJATv_qsl8rcGU9sih-4-EGvygpmDYunc
